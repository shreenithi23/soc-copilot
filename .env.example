# Google Gemini API Key for LLM reasoning and threat hunting
GEMINI_API_KEY=your_gemini_api_key_here

# VirusTotal API v3 Key for real-time threat intelligence and IOC enrichment
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# LangSmith Configuration for tracing, monitoring, and pipeline evaluation
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=soc-copilot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Database Configuration (Supabase PostgreSQL or fallback to local SQLite)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_PATH=soc_copilot.db

# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Redis Streams Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

